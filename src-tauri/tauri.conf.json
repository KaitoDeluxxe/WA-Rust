{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhatsApp Desktop",
  "version": "0.1.0",
  "identifier": "com.whatsapp.desktop.light",
  "build": {
    "frontendDist": "../dist",
    "devUrl": null,
    "beforeDevCommand": null,
    "beforeBuildCommand": null
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WhatsApp Desktop",
        "width": 1100,
        "height": 750,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true,
        "fullscreen": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Lightweight WhatsApp Web wrapper",
    "longDescription": "A small, cross-platform desktop wrapper around WhatsApp Web using the OS webview. No bundled browser engine."
  }
}